{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "../..",
    "paths": {
      "@orderflow/common": ["libs/common/dist/index.d.ts"],
      "@orderflow/common/*": ["libs/common/dist/*"],
      "@orderflow/contracts": ["libs/contracts/dist/index.d.ts"],
      "@orderflow/testing": ["libs/testing/src/index.ts"],
      "@orderflow/testing/*": ["libs/testing/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
