{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@orderflow/contracts": ["libs/contracts/src/index.ts"],
      "@orderflow/contracts/*": ["libs/contracts/src/*"],
      "@orderflow/common": ["libs/common/src/index.ts"],
      "@orderflow/common/*": ["libs/common/src/*"]
    }
  }
}
