{
  "name": "orderflow",
  "version": "0.1.0",
  "private": true,
  "description": "OrderFlow - distributed e-commerce order management system (Phase 1 foundation)",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:infra": "docker compose -f deploy/docker-compose.infra.yml up -d",
    "dev:down": "docker compose -f deploy/docker-compose.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
