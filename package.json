{
  "name": "orderflow",
  "version": "0.1.0",
  "private": true,
  "description": "OrderFlow - distributed e-commerce order management system (Phase 3 core services)",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build:contracts": "npm run build --workspace=@orderflow/contracts",
    "build:common": "npm run build --workspace=@orderflow/common",
    "build:testing": "npm run build --workspace=@orderflow/testing",
    "build:order": "npm run build --workspace=@orderflow/order-service",
    "build:inventory": "npm run build --workspace=@orderflow/inventory-service",
    "build:payment": "npm run build --workspace=@orderflow/payment-service",
    "build:notification": "npm run build --workspace=@orderflow/notification-service",
    "build:gateway": "npm run build --workspace=@orderflow/api-gateway",
    "build": "npm run build:contracts && npm run build:common && npm run build:testing && npm run build:order && npm run build:inventory && npm run build:payment && npm run build:notification && npm run build:gateway",
    "dev:order": "npm run dev --workspace=@orderflow/order-service",
    "start:order": "npm run start --workspace=@orderflow/order-service",
    "dev:inventory": "npm run dev --workspace=@orderflow/inventory-service",
    "start:inventory": "npm run start --workspace=@orderflow/inventory-service",
    "dev:payment": "npm run dev --workspace=@orderflow/payment-service",
    "start:payment": "npm run start --workspace=@orderflow/payment-service",
    "dev:notification": "npm run dev --workspace=@orderflow/notification-service",
    "start:notification": "npm run start --workspace=@orderflow/notification-service",
    "dev:gateway": "npm run dev --workspace=@orderflow/api-gateway",
    "start:gateway": "npm run start --workspace=@orderflow/api-gateway",
    "test:gateway": "npm run test --workspace=@orderflow/api-gateway",
    "test:order": "npm run test --workspace=@orderflow/order-service",
    "test:inventory": "npm run test --workspace=@orderflow/inventory-service",
    "test:payment": "npm run test --workspace=@orderflow/payment-service",
    "test:notification": "npm run test --workspace=@orderflow/notification-service",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:infra": "docker compose --env-file .env -f deploy/docker-compose.infra.yml up -d",
    "dev:stack": "docker compose --env-file .env -f deploy/docker-compose.yml up --build",
    "dev:down": "docker compose --env-file .env -f deploy/docker-compose.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
