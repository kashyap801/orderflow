# OrderFlow environment template. Copy to .env and replace every placeholder.
# NEVER commit real secrets. Values below are intentionally non-functional.

# ---------- Global ----------
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# ---------- Ports (host-side, Docker Compose maps to these) ----------
PORT_API_GATEWAY=3000
PORT_ORDER_SERVICE=3001
PORT_INVENTORY_SERVICE=3002
PORT_PAYMENT_SERVICE=3003
PORT_NOTIFICATION_SERVICE=3004
PORT_WEB=5173

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# ---------- MongoDB (local single-node replica set; Atlas in hosted environments) ----------
# Transactions require a replica set; Docker Compose starts MongoDB with --replSet rs0.
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_REPLICA_SET=rs0
MONGODB_USER=orderflow
MONGODB_PASSWORD=change-me
MONGODB_AUTH_SOURCE=admin

# Mongoose reads one URI per service (no cross-service database access).
MONGODB_URI_ORDER=mongodb://orderflow:change-me@localhost:27017/orderflow_order?replicaSet=rs0&authSource=admin
MONGODB_URI_INVENTORY=mongodb://orderflow:change-me@localhost:27017/orderflow_inventory?replicaSet=rs0&authSource=admin
MONGODB_URI_PAYMENT=mongodb://orderflow:change-me@localhost:27017/orderflow_payment?replicaSet=rs0&authSource=admin
MONGODB_URI_NOTIFICATION=mongodb://orderflow:change-me@localhost:27017/orderflow_notification?replicaSet=rs0&authSource=admin

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ---------- Kafka ----------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=orderflow
KAFKA_CONSUMER_GROUP_PREFIX=orderflow

# ---------- Deployment (GitHub → Vercel + Render; managed Atlas/Upstash/Confluent) ----------
# Real values are injected by Vercel/Render/GitHub Actions secrets; never commit them.
VITE_API_BASE_URL=http://localhost:3000/api/v1
ORDER_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003
VERCEL_ORIGIN=http://localhost:5173

# ---------- Behaviour ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
RESERVATION_TTL_MINUTES=15
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
CONSUMER_MAX_RETRIES=3
PAYMENT_SIMULATION_MAX_DELAY_MS=1500
