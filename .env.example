# OrderFlow environment template. Copy to .env and replace every placeholder.
# NEVER commit real secrets. Values below are intentionally non-functional.

# ---------- Global ----------
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
# Leave empty locally (Vite proxies /api to the gateway). Set to the deployed gateway URL on Vercel.
VITE_API_URL=

# ---------- Ports (host-side, Docker Compose maps to these) ----------
# Service-specific keys are used in Phase 3; PORT is retained for compatibility.
PORT=3001
PORT_API_GATEWAY=3000
PORT_ORDER_SERVICE=3001
PORT_INVENTORY_SERVICE=3002
PORT_PAYMENT_SERVICE=3003
PORT_NOTIFICATION_SERVICE=3004
PORT_WEB=5173

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# ---------- MongoDB (local single-node replica set; Atlas in hosted environments) ----------
# Transactions require a replica set; Docker Compose starts MongoDB with --replSet rs0.
# Local Compose intentionally disables auth; Atlas credentials belong inside MONGODB_URI_* secrets.
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_REPLICA_SET=rs0

# Mongoose reads one URI per service (no cross-service database access).
# Host-side runs use directConnection so the replica-set member name does not need a hosts-file entry.
# Docker Compose overrides these with replicaSet=rs0 and the internal "mongo" hostname.
MONGODB_URI_ORDER=mongodb://localhost:27017/orderflow_order?directConnection=true
MONGODB_URI_INVENTORY=mongodb://localhost:27017/orderflow_inventory?directConnection=true
MONGODB_URI_PAYMENT=mongodb://localhost:27017/orderflow_payment?directConnection=true
MONGODB_URI_NOTIFICATION=mongodb://localhost:27017/orderflow_notification?directConnection=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=1000
MONGODB_AUTO_INDEX=true

# ---------- Redis ----------
# Used only for product-read caching in Inventory Service. MongoDB remains the source of truth.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ---------- Kafka ----------
# Order publishes ORDER_CREATED; Notification consumes it. No topics/retries/DLQ to configure.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=orderflow
KAFKA_CONSUMER_GROUP_ID=orderflow-notification

# ---------- Deployment (GitHub → Vercel + Render; managed Atlas/Upstash/Confluent) ----------
# Real values are injected by Vercel/Render/GitHub Actions secrets; never commit them.
VITE_API_BASE_URL=http://localhost:3000/api/v1
ORDER_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
VERCEL_ORIGIN=http://localhost:5173

# ---------- Behaviour ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
RESERVATION_TTL_MINUTES=15
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
CONSUMER_MAX_RETRIES=3
PAYMENT_SIMULATION_MAX_DELAY_MS=1500
